{
  "schemaVersion": 1,
  "id": "mishanguc",
  "version": "${version}",
  "name": "Mishang Urban Construction - XH Edition",
  "description": "The mod provides an amount of blocks and items that make a beautiful city, which includes roads, signs, lights, handrails, colored blocks and some useful tools. Thank you for using this mod. I'm looking forward to your suggestions. This is an unofficial fork modified for XinghaiCity Server.",
  "authors": [
    "SolidBlock"
  ],
  "contributors": [
    "xiaobaimao233"
  ],
  "contact": {
    "sources": "https://github.com/xiaobaimao233/mishanguc-xh-1201",
    "issues": "https://github.com/xiaobaimao233/mishanguc-xh-1201/issues",
    "homepage": "https://github.com/xiaobaimao233/mishanguc-xh-1201"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/mishanguc/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "pers.solid.mishang.uc.Mishanguc"
    ],
    "client": [
      "pers.solid.mishang.uc.MishangucClient"
    ],
    "fabric-datagen": [
      "pers.solid.mishang.uc.data.MishangucDataGeneration"
